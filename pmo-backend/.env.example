# PMO Backend Environment Configuration
# Copy this file to .env and update ALL values marked CHANGE_BEFORE_DEPLOY.
# Never commit the real .env file to version control.

# Database Connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pmo_dashboard
DATABASE_USER=postgres
# Must match POSTGRES_PASSWORD in the root .env
DATABASE_PASSWORD=CHANGE_BEFORE_DEPLOY

# Application
PORT=3000
NODE_ENV=development

# Authentication (JWT)
# REQUIRED — generate a strong secret before any deployment:
#   openssl rand -base64 48
# Using the placeholder below in production makes all tokens forgeable.
AUTH_JWT_SECRET=CHANGE_BEFORE_DEPLOY
AUTH_JWT_EXPIRES_IN=28800

# Frontend URL — used for CORS origin restriction and Google OAuth redirect.
# In dev this can remain http://localhost:3001.
# In production set this to the URL end users navigate to (e.g. http://core.carsu.edu.ph).
FRONTEND_URL=http://localhost:3001

# Google OAuth (Optional — leave blank to disable Google login)
# NOTE: env var names must match exactly (google.strategy.ts reads these names):
#   GOOGLE_CALLBACK_URL  (not GOOGLE_REDIRECT_URI)
#   OAUTH_ALLOWED_DOMAIN (not GOOGLE_ALLOWED_DOMAINS)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
OAUTH_ALLOWED_DOMAIN=carsu.edu.ph

# LDAP / Directory (Optional — institutional SSO). The CSU directory is OpenLDAP/POSIX (users keyed
# by `uid`, plain ldap:// on 389) — NOT Active Directory. Do not use sAMAccountName or ldaps://:636.
# The LDAP strategy is registered ONLY when LDAP_URL is set (auth.module.ts).
# Leave all LDAP_* lines commented out to disable LDAP entirely.
# DERIVE these from a working `ldapsearch` at go-live — see handover/ldap-test/MIS_SWAP.md.
# LDAP_URL=ldap://<ldap-host>:389
# LDAP_BIND_DN=<bind DN under dc=carsu,dc=edu,dc=ph>
# LDAP_BIND_PASSWORD=CHANGE_BEFORE_DEPLOY
# LDAP_SEARCH_BASE=dc=carsu,dc=edu,dc=ph
# LDAP_SEARCH_FILTER=(uid={{username}})
# LDAP_TLS_REJECT_UNAUTHORIZED=true
#
# JIT auto-provisioning (T-LDAP-JIT): when true, a valid LDAP/AD user who has NO local
# account is AUTO-CREATED on first login with dashboard-only access (default-DENY) — an
# admin still grants module access afterward via Access Control. When false/unset, an
# LDAP user must be pre-created locally first (the original fail-closed behavior).
# Default OFF. This is the production kill switch: set false + redeploy to revert instantly.
# LDAP_AUTO_PROVISION=false

# Fresh-database SuperAdmin seed (Docker first-deploy only)
# seed.js runs ONLY when migrate.js detects an empty database.
# Has NO effect on an existing database — changing these after first deploy does nothing.
# CHANGE BOTH before any user accesses the system.
# Generate: openssl rand -base64 16
SEED_PMOADMIN_PASSWORD=CHANGE_BEFORE_DEPLOY
SEED_ADMIN_PASSWORD=CHANGE_BEFORE_DEPLOY

# File Uploads
UPLOAD_DIR=./uploads

# Storage backend: "local" (disk under UPLOAD_DIR) or "minio" (S3-compatible).
# This is the rollback switch for the object-storage migration — flip it back to
# local and restart to revert instantly. Compose does NOT override this value, so
# it is per-developer/per-environment and lives here on purpose.
STORAGE_DRIVER=local

# MinIO — only read when STORAGE_DRIVER=minio.
# UNDER DOCKER these are overridden by docker-compose.dev.yml from the ROOT .env,
# because the client credentials must match the minio server's root credentials.
# The values below are for running the backend on the HOST (npm run start:dev)
# against the container's published port: "minio" is a compose-network name that
# does not resolve from your shell, so use localhost + MINIO_HOST_PORT here.
# (Same trap as LDAP's 389 vs 1389.)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Must match MINIO_ACCESS_KEY / MINIO_SECRET_KEY in the root .env.
# MinIO rejects a user under 3 chars or a password under 8 chars.
MINIO_ACCESS_KEY=CHANGE_BEFORE_DEPLOY
MINIO_SECRET_KEY=CHANGE_BEFORE_DEPLOY
MINIO_BUCKET_NAME=pmo-uploads
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv
