# Root Docker Compose environment template.
# Copy to ".env" (same directory as docker-compose.yml) and update ALL values
# marked CHANGE_BEFORE_DEPLOY before running docker compose up.
# Never commit the real .env file to version control.
# Keep POSTGRES_* in sync with the DATABASE_* values in pmo-backend/.env.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
BACKEND_PORT=
FRONTEND_PORT=

# Minio Configuration
# MINIO_ENDPOINT/MINIO_PORT are how the BACKEND CONTAINER reaches MinIO over the
# compose network — keep them "minio" and 9000. They are not host-side settings.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# These double as the MinIO server's root credentials (MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD) and the backend's client credentials, so the two can never
# drift. MinIO refuses to start if the user is under 3 chars or the password is
# under 8 chars. Generate: openssl rand -base64 24
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=pmo-uploads
MINIO_USE_SSL=false

# Host-side ports only — change these if 9000/9001 are already taken locally.
# Never point MINIO_PORT at these; that variable is container-internal.
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_PORT=9001

SEED_PMOADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

